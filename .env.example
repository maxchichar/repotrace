# Optional server-only public GitHub API authentication. Never use NEXT_PUBLIC_.
GITHUB_TOKEN=
# Optional opt-in AI summaries. API host is fixed to api.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Use a persistent writable volume for share links in a deployed single instance.
REPORT_DIR=.data/reports

# PostgreSQL is REQUIRED on Vercel; optional locally. Run npm run db:migrate before start.
DATABASE_URL=

# Optional fixed production browser origin; leave unset for Vercel preview origins.
APP_ORIGIN=
